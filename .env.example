# Template env — salin jadi .env lalu isi nilai asli (lihat .gitignore).
# JANGAN pernah commit file .env asli.

# Supabase (publishable — aman untuk client, akses data tetap dikunci RLS)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=sb_publishable_xxx

# Supabase service key — HANYA server (runtimeConfig privat), jangan sampai
# ke client bundle (standar data terkunci §4)
SUPABASE_SERVICE_KEY=sb_secret_xxx

# Koneksi Postgres langsung — untuk migrasi/seed via psql, bukan aplikasi.
# Nama SUPABASE_DB_URL dipakai agar tidak bentrok dengan DATABASE_URL legacy
# yang mungkin di-set environment sandbox/host (Prisma file:).
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Koneksi pooler IPv4 (fallback bila jaringan tanpa IPv6 — sandbox/host):
# user = postgres.<project-ref>, host = aws-1-<region>.pooler.supabase.com

# Sumber data provider (standar data terkunci §4): supabase | mock
DATA_PROVIDER=supabase
